{
  "openapi": "3.1.0",
  "info": {
    "title": "VPS-Commander",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://hub.example.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "is_local": {
            "type": "boolean"
          },
          "arch": {
            "type": "string"
          },
          "os": {
            "type": "string"
          }
        }
      },
      "ExecRequest": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "workdir": {
            "type": "string"
          },
          "timeout": {
            "type": "integer"
          }
        }
      },
      "ExecResponse": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer"
          }
        }
      },
      "FileReadRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "FileReadResponse": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "eof": {
            "type": "boolean"
          },
          "total_size": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "FileWriteRequest": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "FileWriteResponse": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          }
        }
      },
      "MCPService": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "args_json": {
            "type": "string"
          },
          "env_json": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "headers_json": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "target_nodes_json": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "MCPCallRequest": {
        "type": "object",
        "required": [
          "device",
          "server",
          "tool"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/devices": {
      "get": {
        "operationId": "list_devices",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Devices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exec": {
      "post": {
        "operationId": "exec_command",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/file/read": {
      "post": {
        "operationId": "read_file",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileReadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileReadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/file/write": {
      "post": {
        "operationId": "write_file",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Write result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileWriteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mcp/services": {
      "get": {
        "operationId": "list_mcp_services",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "MCP services",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MCPService"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "save_mcp_service",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MCPService"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved MCP service"
          }
        }
      }
    },
    "/api/v1/mcp/service": {
      "delete": {
        "operationId": "delete_mcp_service",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/v1/mcp/list": {
      "get": {
        "operationId": "list_agent_mcp",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "device",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mounted MCP services"
          },
          "409": {
            "description": "Device offline"
          }
        }
      }
    },
    "/api/v1/mcp/call": {
      "post": {
        "operationId": "call_agent_mcp",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MCPCallRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP result"
          },
          "409": {
            "description": "Device offline"
          }
        }
      }
    },
    "/api/v1/security/settings": {
      "get": {
        "summary": "Get security policy",
        "responses": {
          "200": {
            "description": "Current global and per-node security policy"
          }
        }
      }
    },
    "/api/v1/security/settings/update": {
      "post": {
        "summary": "Update security policy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "global": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "node": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "inherit",
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/notifications/webhooks": {
      "get": {
        "summary": "List webhook targets",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/notifications/webhook/update": {
      "post": {
        "summary": "Create or update webhook target",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "url"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "generic",
                      "telegram",
                      "wecom"
                    ]
                  },
                  "url": {
                    "type": "string"
                  },
                  "config_json": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/notifications/webhook/delete": {
      "delete": {
        "summary": "Delete webhook target",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/notifications/webhook/test": {
      "post": {
        "summary": "Send webhook test message",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/devices/file/edit_block": {
      "post": {
        "summary": "Atomically replace a unique text block on a device",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "old_text",
                  "new_text"
                ],
                "properties": {
                  "device": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "old_text": {
                    "type": "string"
                  },
                  "new_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edited"
          },
          "403": {
            "description": "Security policy denied"
          },
          "409": {
            "description": "Device offline or edit conflict"
          },
          "413": {
            "description": "Edit block too large"
          }
        }
      }
    },
    "/api/v1/process/session": {
      "post": {
        "summary": "Manage long-running process sessions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "read",
                "input",
                "stop",
                "list"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session operation result"
          }
        }
      }
    },
    "/api/v1/file/list": {
      "post": {
        "summary": "List directory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result"
          }
        }
      }
    },
    "/api/v1/file/info": {
      "post": {
        "summary": "Get file metadata",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result"
          }
        }
      }
    },
    "/api/v1/file/search": {
      "post": {
        "summary": "Search files",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result"
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "summary": "Emit a custom notification event",
        "description": "Requires the events:emit token scope. The selected template defines the event type and default severity. P1 or severity escalation requires admin. Requests are limited to 30 per token per minute; Idempotency-Key replays return the original event.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "template_id"
                ],
                "properties": {
                  "template_id": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "P1",
                      "P2",
                      "P3",
                      "P4"
                    ]
                  },
                  "variables": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "device": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Event accepted and delivery rows created"
          },
          "200": {
            "description": "Idempotent replay of an accepted event"
          },
          "400": {
            "description": "Invalid event/template/variables"
          },
          "403": {
            "description": "Missing scope or unprivileged severity escalation"
          },
          "409": {
            "description": "Idempotency-Key reused with a different request"
          },
          "429": {
            "description": "Per-token rate limit exceeded"
          },
          "500": {
            "description": "Persistence failure"
          }
        }
      }
    },
    "/api/v1/notifications/channels": {
      "get": {
        "summary": "List notification channels (secrets and endpoints redacted)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notification channels"
          }
        }
      },
      "post": {
        "summary": "Create or update a notification channel",
        "description": "Requires admin. Provider credentials are supplied in secrets_json and encrypted at rest. The response never returns secrets or raw endpoint URLs. QQ official bot channels are disabled for proactive alerts.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "webhook",
                      "telegram_bot",
                      "qq_official_bot"
                    ]
                  },
                  "endpoint": {
                    "type": "string"
                  },
                  "config_json": {
                    "type": "object"
                  },
                  "secrets_json": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Channel saved"
          },
          "400": {
            "description": "Invalid channel config"
          }
        }
      },
      "delete": {
        "summary": "Disable a notification channel and dependent tasks",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Channel disabled"
          },
          "400": {
            "description": "Cannot disable this channel"
          }
        }
      }
    },
    "/api/v1/notifications/templates": {
      "get": {
        "summary": "List event templates",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notification templates"
          }
        }
      },
      "post": {
        "summary": "Create or update an event template",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "event_type",
                  "severity",
                  "format",
                  "body_template",
                  "variables_json"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "event_type": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "P1",
                      "P2",
                      "P3",
                      "P4",
                      "*"
                    ]
                  },
                  "title_template": {
                    "type": "string"
                  },
                  "body_template": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "text",
                      "markdown",
                      "raw_json"
                    ]
                  },
                  "variables_json": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template saved"
          },
          "400": {
            "description": "Invalid template"
          }
        }
      },
      "delete": {
        "summary": "Disable a template and dependent tasks",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template disabled"
          },
          "400": {
            "description": "Cannot disable this template"
          }
        }
      }
    },
    "/api/v1/notifications/tasks": {
      "get": {
        "summary": "List notification tasks",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notification tasks"
          }
        }
      },
      "post": {
        "summary": "Create or update a notification task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
