                  "name": {
                    "type": "string"
                  },
                  "channel_id": {
                    "type": "string"
                  },
                  "template_id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "event_types_json": {
                    "type": "string"
                  },
                  "severities_json": {
                    "type": "string"
                  },
                  "policy_json": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task saved"
          },
          "400": {
            "description": "Invalid task"
          }
        }
      },
      "delete": {
        "summary": "Disable a task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task disabled"
          },
          "400": {
            "description": "Cannot disable this task"
          }
        }
      }
    },
    "/api/v1/notifications/channels/test": {
      "post": {
        "summary": "Send a test notification through a configured channel",
        "description": "Requires admin. Sends one test message and updates last-attempt/success/failure status; raw endpoints and credentials are not returned.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
